DATABASE_URL="postgresql://user:password@localhost:5432/meylio"
PORT=3000

# Apple Music (developer.apple.com/account/resources/authkeys)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Colle le contenu du fichier .p8 ici (garde les \n littéraux si sur une seule ligne)
APPLE_MUSIC_PRIVATE_KEY=

# Clé d'accès à l'interface de modération admin
ADMIN_KEY=

# Octopush (octopush.com) — envoi des SMS de connexion
OCTOPUSH_API_LOGIN=
OCTOPUSH_API_KEY=
OCTOPUSH_SENDER=Meylio

# AWS Rekognition — détection de visage sur les photos de profil et
# comparaison du selfie avec la première photo (vérification d'identité).
# Sans ces clés, la détection/comparaison est ignorée (tout est autorisé,
# aucun profil n'est marqué vérifié) — voir src/services/faceRecognition.ts
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RevenueCat — secret partagé configuré côté dashboard RevenueCat
# (Project settings > Integrations > Webhooks > Authorization header)
REVENUECAT_WEBHOOK_SECRET=
